{
  "name": "product-management-system",
  "version": "1.0.0",
  "description": "Full-Stack Enterprise Product & Inventory Management System (ERP) built with React 19, TypeScript, Tailwind CSS v4, Node.js, Express, and MongoDB.",
  "main": "server/src/server.js",
  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed:demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peymanbabayev/product-management-system.git"
  },
  "keywords": [
    "mern",
    "inventory-management",
    "product-management",
    "erp",
    "react19",
    "typescript",
    "tailwindcss",
    "nodejs",
    "express",
    "mongodb",
    "tanstack-query",
    "vite"
  ],
  "author": "Peyman Babayev",
